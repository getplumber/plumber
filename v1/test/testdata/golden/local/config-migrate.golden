--- file legacy.plumber.yaml.v2
# Legacy control name, renamed by `plumber config migrate`.
version: "2.0"
github:
  controls:
    workflowsMustDeclarePermissions:
      enabled: true
    # Cache poisoning
    untrustedTriggersMustNotWriteCache:
      enabled: false
    pipelineMustNotEnableDebugTrace:
      enabled: true

