  "analyzeBranch": "findings",
  "analyzedCiConfig": {
    "workflows": [
      {
        "content": "name: Build\n\n# INTENTIONALLY INSECURE — extends the critical demo with two controls the\n# other workflows don't exercise: archived actions and a weakened security job.\n\non:\n  push:\n    branches: [main]\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: ${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: true\n\njobs:\n  release-notes:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3\n        with:\n          persist-credentials: false\n      # Upstream repo is archived (read-only, unmaintained — no more security\n      # fixes, and the last maintainer can still push a new SHA over the tag).\n      # ISSUE-702 (API).\n      - uses: actions/create-release@v1\n        env:\n          GITHUB_TOKEN: ${{ github.token }}\n\n  security-scan:\n    runs-on: ubuntu-latest\n    # A security scanner neutered with continue-on-error: the job is allowed to\n    # fail, so a real finding never blocks the pipeline. ISSUE-410.\n    continue-on-error: true\n    steps:\n      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3\n        with:\n          persist-credentials: false\n      - name: run scanner\n        run: echo \"pretend to scan for secrets\"\n",
        "path": ".github/workflows/build.yml"
      },
      {
        "content": "# INTENTIONALLY INSECURE — this workflow exists to trip Plumber controls.\n# It has no `name:` (ISSUE-601) and no `concurrency:` (ISSUE-418).\non:\n  push:\n    branches: [main]\n  pull_request:\n\n# Grants every scope to GITHUB_TOKEN. ISSUE-803 (high).\npermissions: write-all\n\nenv:\n  # Streams secrets into job logs at debug verbosity. ISSUE-203 (critical).\n  ACTIONS_STEP_DEBUG: true\n  # Re-enables ::set-env:: / ::add-path:: style command injection. ISSUE-208 (high).\n  ACTIONS_ALLOW_UNSECURE_COMMANDS: \"true\"\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    container:\n      # Mutable, non-digest tag from the forbidden list. ISSUE-102 (medium) + ISSUE-103 (high).\n      image: node:latest\n      credentials:\n        username: ci-bot\n        # Registry password hardcoded in plaintext. ISSUE-704 (critical).\n        password: sup3rs3cr3t-do-not-commit\n    steps:\n      # actions/* is a trusted owner (no ISSUE-701) but credentials persist by\n      # default into .git/config. ISSUE-307 (high).\n      - uses: actions/checkout@v4\n\n      # Third-party action pinned by tag, with a published advisory, from an\n      # owner outside the authorized allowlist.\n      # ISSUE-701 (high) + ISSUE-703 (critical, API) + ISSUE-713 (high).\n      - uses: tj-actions/changed-files@v45.0.0\n\n      # Third-party action pinned to a 40-char SHA that does not exist in the\n      # upstream repo (a real action, but this commit was never pushed there),\n      # from an owner outside the authorized allowlist.\n      # ISSUE-707 impostor-commit (critical, API) + ISSUE-713 (high).\n      - uses: dorny/paths-filter@1c9b1f1aaa2222bbbb3333cccc4444dddd5555ee\n\n      # Unpinned package install. ISSUE-214 (medium).\n      - name: install tooling\n        run: npm install -g some-build-tool\n\n      # Pipes a remote script straight into a shell. ISSUE-411 (high).\n      - name: bootstrap\n        run: curl -sSL https://get.example.com/install.sh | bash\n\n      # Untrusted PR title interpolated into the shell. ISSUE-207 (critical).\n      - name: greet\n        run: echo \"Building PR ${{ github.event.pull_request.title }}\"\n\n      # Untrusted input written to $GITHUB_ENV. ISSUE-209 (critical).\n      - name: export title\n        run: echo \"PR_TITLE=${{ github.event.pull_request.title }}\" \u003e\u003e \"$GITHUB_ENV\"\n\n      # Whole github context serialized into a command. ISSUE-213 (high).\n      - name: dump context\n        run: echo '${{ toJson(github) }}'\n\n      # Entire secrets context exported as one blob. ISSUE-309 (critical).\n      - name: export secrets\n        env:\n          ALL_SECRETS: ${{ toJson(secrets) }}\n        run: echo \"$ALL_SECRETS\" \u003e /tmp/secrets.json\n\n      # Uploads the entire workspace, including .git. ISSUE-419 (medium).\n      - uses: actions/upload-artifact@v4\n        with:\n          name: everything\n          path: .\n      - name: Upload SARIF\n        uses: github/codeql-action/upload-sarif@v2 # Actions must not use ambiguous tag/branch refs. ISSUE-710 (Medium)\n        with:\n          sarif_file: results.sarif\n\n  auto-approve:\n    # github.actor is attacker-spoofable. ISSUE-210 (high).\n    if: github.actor == 'dependabot[bot]'\n    runs-on: ubuntu-latest\n    steps:\n      - run: echo \"auto-approving\"\n",
        "path": ".github/workflows/ci.yml"
      },
      {
        "content": "name: Post-CI\n\n# workflow_run is a \"dangerous\" trigger: it runs in the base context with secrets\n# available, even for runs originating from forks. Combined with a checkout of the\n# triggering run's head SHA, this is remote code execution. ISSUE-802 (critical).\non:\n  workflow_run:\n    workflows: [\"CI\"]\n    types: [completed]\n\npermissions:\n  contents: read\n\njobs:\n  comment:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          ref: ${{ github.event.workflow_run.head_sha }}\n      - run: npm ci\n      - run: node ./scripts/post-results.js\n",
        "path": ".github/workflows/dangerous.yml"
      },
      {
        "content": "name: Plumber\n\non:\n  push:\n    branches: [main]\n  pull_request:\n    branches: [main]\n\n# Least-privilege: read the repo, write SARIF to code scanning.\n# id-token is for the Plumber Score push (publishes only from the default branch).\npermissions:\n  contents: read\n  security-events: write\n  id-token: write\n\nconcurrency:\n  group: ${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: true\n\njobs:\n  scan:\n    runs-on: ubuntu-24.04\n    steps:\n      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3\n        with:\n          persist-credentials: false\n      - uses: getplumber/plumber@f84005b69dc57965d192feedd08b4a20fa6e52cc # v0.4.60\n        with:\n          # This repo is deliberately dangerous (target grade E). Surface every\n          # finding to code scanning and publish the live Plumber Score badge,\n          # but don't hard-fail CI on the expected result.\n          soft-fail: true\n          score-push: true\n",
        "path": ".github/workflows/plumber.yml"
      },
      {
        "content": "name: PR Preview\n\n# pull_request_target runs with a read/write token in the BASE repo context,\n# but this workflow then checks out the untrusted PR HEAD. ISSUE-804 (critical).\non:\n  pull_request_target:\n    branches: [main]\n\npermissions:\n  contents: read\n  pull-requests: write\n\njobs:\n  preview:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          # Fork-controlled code, executed with elevated context.\n          ref: ${{ github.event.pull_request.head.sha }}\n      - run: npm ci\n      - run: npm run build\n\n",
        "path": ".github/workflows/pr-preview.yml"
      },
      {
        "content": "name: Release\n\non:\n  release:\n    types: [published]\n\n# write-all again. ISSUE-803 (high).\npermissions: write-all\n\njobs:\n  publish:\n    runs-on: ubuntu-latest\n    # No `environment:` gate on a job that consumes a publish secret. ISSUE-305 (medium).\n    steps:\n      - uses: actions/checkout@v4 # persists credentials. ISSUE-307 (high).\n      - uses: actions/setup-node@v4\n        with:\n          node-version: \"20\"\n          registry-url: https://registry.npmjs.org\n      # Cache key is not scoped to the ref, so a poisoned cache from an untrusted\n      # branch can be restored into the release build. ISSUE-705 (high).\n      - uses: actions/cache@v4\n        with:\n          path: ~/.npm\n          key: npm-${{ hashFiles('**/package-lock.json') }}\n      - run: npm ci\n      - run: npm run build\n      # Long-lived NPM_TOKEN instead of OIDC trusted publishing (ISSUE-421, high),\n      # and the published artifact is never signed (ISSUE-712, medium).\n      - run: npm publish\n        env:\n          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}\n",
        "path": ".github/workflows/release.yml"
      }
    ]
  },
