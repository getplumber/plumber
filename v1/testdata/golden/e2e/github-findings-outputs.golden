        "Plumber"
      ],
      "requirements": [
        "ISSUE-802"
      ],
      "status": "Fail",
      "status_id": 3,
      "status_details": [
        "job \"dangerous/comment\" runs under dangerous trigger(s) workflow_run and checks out fork-controlled code — untrusted code executes with the base repo's secrets (CVE-2025-30066 pattern)"
      ]
    },
    "finding_info": {
      "uid": "plumber:getplumber-examples/plumber-cli-e2e:findings:<EPOCH>:workflowMustNotUseDangerousTriggers",
      "title": "Workflows must not use dangerous triggers",
      "desc": "A GitHub Actions job is reachable via a trigger that runs with the base repository's secrets while being influenceable by an unprivileged caller (`workflow_run`, `issue_comment`, `pull_request_review`, `pull_request_review_comment`, `discussion`, `discussion_comment`, `gollum`, `fork`) AND it checks out fork-controlled code. The `pull_request_target` case is owned by ISSUE-804 (pull-request-target-with-head-checkout). This is the same exploit class as the March 2025 tj-actions/changed-files supply-chain compromise (CVE-2025-30066).",
      "types": [
        "CI/CD Security",
        "Supply Chain",
        "Security"
      ],
      "src_url": "https://getplumber.io/docs/cli/issues/ISSUE-802"
    },
    "remediation": {
      "desc": "Prefer the standard `pull_request` trigger unless access to base-repo secrets is strictly required. If a secret-bearing trigger is necessary, never check out fork content and never render github.event.* / github.head_ref into shell commands. For `workflow_run`, keep the job restricted to non-secret-bearing steps."
    },
    "resources": [
      {
        "type": "code_repository",
        "name": "getplumber-examples/plumber-cli-e2e",
        "uid": "https://github.com/getplumber-examples/plumber-cli-e2e",
