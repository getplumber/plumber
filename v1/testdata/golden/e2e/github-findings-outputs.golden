    "message": "Control \"Checkout must not persist credentials\" failed: 4 finding(s).",
    "metadata": {
      "version": "1.8.0",
      "product": {
        "name": "Plumber",
        "vendor_name": "getplumber",
        "version": "dev",
        "url_string": "https://getplumber.io"
      },
