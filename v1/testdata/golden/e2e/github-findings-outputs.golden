    "class_uid": 2003,
    "type_uid": 200301,
    "time": <EPOCH>,
    "severity_id": 5,
    "status_id": 1,
    "message": "Control \"Workflows must not expose all secrets at once\" failed: 1 finding(s).",
    "metadata": {
      "version": "1.8.0",
      "product": {
        "name": "Plumber",
        "vendor_name": "getplumber",
        "version": "dev",
        "url_string": "https://getplumber.io"
      },
      "correlation_uid": "plumber:getplumber-examples/plumber-cli-e2e:findings:<EPOCH>"
    },
    "compliance": {
      "control": "workflowMustNotExportEntireSecretsContext",
      "standards": [
        "Plumber"
      ],
      "requirements": [
        "ISSUE-309"
      ],
      "status": "Fail",
      "status_id": 3,
      "status_details": [
        "job \"ci/build\" exposes all its secrets at once via toJson(secrets) — pass secrets by name instead"
      ]
    },
    "finding_info": {
      "uid": "plumber:getplumber-examples/plumber-cli-e2e:findings:<EPOCH>:workflowMustNotExportEntireSecretsContext",
      "title": "Workflows must not expose all secrets at once",
      "desc": "A GitHub Actions workflow serialises the whole `secrets` context with `toJson(secrets)` or `toJSON(secrets)` and pipes the result into a step's environment, run script, or `with:` input. The resulting string contains every secret the job has access to (repository, organisation and environment) and travels through whatever downstream consumer the step passes it to (a third-party action, a remote server, a log line). Even with GitHub's automatic log redaction, a single `echo` of the JSON payload has been enough to leak tokens in past supply-chain incidents; a compromised reusable action sees them directly regardless of logging.",
      "types": [
        "CI/CD Security",
        "Supply Chain",
        "Security"
      ],
      "src_url": "https://getplumber.io/docs/cli/issues/ISSUE-309"
    },
    "remediation": {
      "desc": "Pass only the specific secrets the step needs, by name: `env: { TOKEN: ${{ secrets.NPM_TOKEN }} }`. If the step forwards credentials to a reusable workflow, name each one in the `secrets:` block of the call rather than using `toJson(secrets)`."
    },
    "resources": [
      {
        "type": "code_repository",
        "name": "getplumber-examples/plumber-cli-e2e",
        "uid": "https://github.com/getplumber-examples/plumber-cli-e2e",
        "labels": [
          "findings"
        ]
      }
    ],
