    "compliance": {
      "control": "reusableWorkflowsMustNotInheritSecrets",
      "standards": [
        "Plumber"
      ],
      "requirements": [
        "ISSUE-302"
      ],
      "status": "Pass",
      "status_id": 1
    },
    "finding_info": {
      "uid": "plumber:getplumber-examples/plumber-cli-e2e:findings:<EPOCH>:reusableWorkflowsMustNotInheritSecrets",
      "title": "Reusable workflows must not inherit secrets",
      "desc": "A GitHub Actions job calls a reusable workflow (`jobs.\u003cname\u003e.uses: owner/repo/.github/workflows/x.yml@ref`) with `secrets: inherit`. The call forwards every secret visible to the caller (repo, organisation, environment) to the reusable workflow, regardless of what the reusable workflow actually needs. A compromise of the reusable workflow (upstream maintainer account, malicious PR merged on the reusable side, tag retag) then sees the full secret surface of every caller.",
      "types": [
        "CI/CD Security",
        "Supply Chain",
        "Security"
      ],
      "src_url": "https://getplumber.io/docs/cli/issues/ISSUE-302"
    },
    "resources": [
      {
        "type": "code_repository",
        "name": "getplumber-examples/plumber-cli-e2e",
        "uid": "https://github.com/getplumber-examples/plumber-cli-e2e",
        "labels": [
          "findings"
        ]
      }
    ]
  },
  {
