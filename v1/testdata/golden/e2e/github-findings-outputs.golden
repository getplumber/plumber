    "message": "Control \"Workflows must not write untrusted content to $GITHUB_ENV\" failed: 1 finding(s).",
    "metadata": {
      "version": "1.8.0",
      "product": {
        "name": "Plumber",
        "vendor_name": "getplumber",
        "version": "dev",
        "url_string": "https://getplumber.io"
      },
      "correlation_uid": "plumber:getplumber-examples/plumber-cli-e2e:findings:<EPOCH>"
    },
    "compliance": {
      "control": "workflowMustNotWriteUntrustedContentToGitHubEnv",
      "standards": [
        "Plumber"
      ],
      "requirements": [
        "ISSUE-209"
      ],
      "status": "Fail",
      "status_id": 3,
      "status_details": [
        "job \"ci/build\" writes a user-controlled template expression into $GITHUB_ENV or $GITHUB_PATH; an attacker can hijack later steps"
      ]
    },
    "finding_info": {
      "uid": "plumber:getplumber-examples/plumber-cli-e2e:findings:<EPOCH>:workflowMustNotWriteUntrustedContentToGitHubEnv",
      "title": "Workflows must not write untrusted content to $GITHUB_ENV",
      "desc": "A GitHub Actions `run:` step appends a user-controlled value (PR title, issue body, fork branch name, ...) to `$GITHUB_ENV` or `$GITHUB_PATH`. The appended value becomes an environment variable or PATH entry for every subsequent step in the job. An attacker who controls the value can override existing variables (for example `NODE_OPTIONS=--require=./exfil.js`) or inject a malicious directory at the front of PATH, hijacking any later `npm`, `bash`, etc. invocation and exfiltrating secrets from privileged triggers.",
      "types": [
        "CI/CD Security",
        "Supply Chain",
        "Security"
      ],
      "src_url": "https://getplumber.io/docs/cli/issues/ISSUE-209"
    },
    "remediation": {
      "desc": "Do not write user-controlled values into `$GITHUB_ENV` or `$GITHUB_PATH`. If you must propagate a value derived from user input, bind it through an `env:` block first (`env: { TITLE: ${{ github.event.issue.title }} }`) and validate/escape it before writing, or pass it as a step output instead. Restrict workflows touching these files to non-PR triggers when possible."
    },
    "resources": [
      {
        "type": "code_repository",
        "name": "getplumber-examples/plumber-cli-e2e",
        "uid": "https://github.com/getplumber-examples/plumber-cli-e2e",
        "labels": [
          "findings"
        ]
      }
    ],
    "unmapped": {
      "plumber_findings": [
        {
          "file": ".github/workflows/ci.yml",
