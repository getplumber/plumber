      "status_id": 1
    },
    "finding_info": {
      "uid": "plumber:getplumber-examples/plumber-cli-e2e:findings:<EPOCH>:workflowsMustBeValid",
      "title": "Workflow files must be valid",
      "desc": "A file under `.github/workflows` cannot be parsed as a workflow by Plumber's own parser (an undefined YAML anchor, a tab-indented block, a duplicate key, a syntax error). GitHub shows a workflow file it cannot read as invalid on the Actions tab and does not run it, so whatever that workflow was meant to do, a test, a security scan, a release gate, never happens, and nothing else in the repository notices. Only a YAML parse failure is reported: a well-formed file GitHub still rejects on its own schema checks, such as a job without runs-on, is out of scope.",
      "types": [
        "CI/CD Security",
        "Supply Chain",
        "Security"
      ],
      "src_url": "https://getplumber.io/docs/cli/issues/ISSUE-423"
    },
    "resources": [
