        "ISSUE-705"
      ],
      "status": "Pass",
      "status_id": 1
    },
    "finding_info": {
      "uid": "plumber:getplumber-examples/plumber-cli-e2e:findings:<EPOCH>:untrustedTriggersMustNotWriteCache",
      "title": "Untrusted triggers must not write the cache",
      "desc": "A job runs on an event GitHub restricts to read-only cache access (pull_request_target, issue_comment, workflow_run and every other event that runs on the default branch, apart from push, workflow_dispatch, repository_dispatch, delete, registry_package, page_build and schedule), and its `cache-mode:` (on the job or its workflow) is `write` or `write-only`. GitHub isolates caches by ref, and a run restores caches from its own ref and from the default branch. The explicit grant lifts GitHub's read-only default, so code running in that job (a comment body, a pull request's head, an upstream run's artifact) can create or overwrite caches that every default-branch run restores, including release and publish jobs.",
      "types": [
        "CI/CD Security",
        "Supply Chain",
        "Security"
      ],
      "src_url": "https://getplumber.io/docs/cli/issues/ISSUE-705"
    },
    "resources": [
      {
        "type": "code_repository",
        "name": "getplumber-examples/plumber-cli-e2e",
        "uid": "https://github.com/getplumber-examples/plumber-cli-e2e",
        "labels": [
          "findings"
        ]
      }
    ]
  },
