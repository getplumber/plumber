    "compliance": {
      "control": "actionRefsMustExistUpstream",
      "standards": [
        "Plumber"
      ],
      "requirements": [
        "ISSUE-707"
      ],
      "status": "Fail",
      "status_id": 3,
      "status_details": [
        "job \"ci/build\" pins action \"dorny/paths-filter@1c9b1f1aaa2222bbbb3333cccc4444dddd5555ee\" to a commit SHA that does not exist in the upstream repository (typo, or a commit removed or never pushed upstream)"
      ]
    },
    "finding_info": {
      "uid": "plumber:getplumber-examples/plumber-cli-e2e:findings:<EPOCH>:actionRefsMustExistUpstream",
      "title": "Actions must pin commits that exist upstream",
      "desc": "A workflow pins an action to a commit SHA that does not resolve in the action's upstream repository. That means either the SHA was mistyped (the reference silently runs whatever tag/branch GitHub falls back to, typically the default branch) or, far worse, the author was tricked by a PR comment / stargazer dashboard showing a detached commit that was never merged upstream. The name-and-SHA combination is the precise form of the `impostor commit` attack documented in academic supply-chain literature.",
      "types": [
        "CI/CD Security",
        "Supply Chain",
        "Security"
      ],
      "src_url": "https://getplumber.io/docs/cli/issues/ISSUE-707"
    },
    "remediation": {
      "desc": "Replace the reference with a SHA that actually belongs to the action's repository. Use `gh api repos/\u003cowner\u003e/\u003crepo\u003e/commits/\u003csha\u003e` to verify before committing the change. That endpoint only accepts commit SHAs, so a pin naming an annotated tag object answers 422 there; check it with `gh api repos/\u003cowner\u003e/\u003crepo\u003e/git/tags/\u003csha\u003e` instead, which also reports the tag name and the commit it points at."
    },
    "resources": [
      {
        "type": "code_repository",
        "name": "getplumber-examples/plumber-cli-e2e",
        "uid": "https://github.com/getplumber-examples/plumber-cli-e2e",
        "labels": [
          "findings"
        ]
      }
    ],
