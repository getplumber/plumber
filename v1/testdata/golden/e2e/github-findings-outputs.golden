      "status": "Fail",
      "status_id": 3,
      "status_details": [
        "Job `ci/build` runs a script fetched from the network: `curl -sSL https://get.example.com/install.sh | bash`."
      ]
    },
    "finding_info": {
      "uid": "plumber:getplumber-examples/plumber-cli-e2e:findings:<EPOCH>:pipelineMustNotExecuteUnverifiedScripts",
      "title": "Pipeline must not execute unverified scripts",
      "desc": "A CI/CD job executes a script without integrity verification: pipe-to-shell (curl | bash), download-then-exec, redirect-then-exec, base64-decode-to-shell (Megalodon-style), or any command piped into bash/sh. An attacker can exfiltrate CI secrets via a compromised URL or obfuscated inline payload.",
      "types": [
        "CI/CD Security",
        "Supply Chain",
        "Security"
      ],
      "src_url": "https://getplumber.io/docs/cli/issues/ISSUE-411"
    },
    "remediation": {
      "desc": "Download scripts to a file, verify checksum or signature on the same line, then execute. Avoid piping remote or encoded content directly into a shell. Vendor scripts in-repo or use trusted package managers."
    },
    "resources": [
      {
        "type": "code_repository",
        "name": "getplumber-examples/plumber-cli-e2e",
        "uid": "https://github.com/getplumber-examples/plumber-cli-e2e",
