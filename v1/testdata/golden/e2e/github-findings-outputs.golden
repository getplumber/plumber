    "severity_id": 5,
    "status_id": 1,
    "message": "Control \"pull_request_target workflows must not check out the PR head\" failed: 1 finding(s).",
    "metadata": {
      "version": "1.8.0",
      "product": {
        "name": "Plumber",
        "vendor_name": "getplumber",
        "version": "dev",
        "url_string": "https://getplumber.io"
      },
      "correlation_uid": "plumber:getplumber-examples/plumber-cli-e2e:findings:<EPOCH>"
    },
    "compliance": {
      "control": "pullRequestTargetMustNotCheckoutHead",
      "standards": [
        "Plumber"
      ],
      "requirements": [
        "ISSUE-804"
      ],
      "status": "Fail",
      "status_id": 3,
      "status_details": [
        "job \"pr-preview/preview\" runs under pull_request_target AND checks out the PR head (ref=\"${{ github.event.pull_request.head.sha }}\") — base-repo secrets and fork-controlled code in the same run (tj-actions / CVE-2025-30066 pattern)"
      ]
    },
    "finding_info": {
      "uid": "plumber:getplumber-examples/plumber-cli-e2e:findings:<EPOCH>:pullRequestTargetMustNotCheckoutHead",
      "title": "pull_request_target workflows must not check out the PR head",
      "desc": "A workflow triggered by `pull_request_target` calls `actions/checkout` with an explicit `ref:` pointing at the pull request's head (e.g. `github.event.pull_request.head.sha`, `github.head_ref`). This is the exact pattern behind the March 2025 tj-actions/changed-files compromise (CVE-2025-30066): the workflow has access to the base repository's secrets AND it executes code controlled by the PR author. Any shell step that runs after the checkout is a direct path to secret exfiltration. Unlike the broader dangerous-triggers check (ISSUE-802) which flags the trigger itself, this rule flags the actual exploitable combination.",
      "types": [
        "CI/CD Security",
        "Supply Chain",
        "Security"
      ],
      "src_url": "https://getplumber.io/docs/cli/issues/ISSUE-804"
    },
    "remediation": {
      "desc": "Either switch to the standard `pull_request` event (runs in the fork's context, no base-repo secrets), or remove the explicit `ref:` input so `actions/checkout` falls back to the base repository's SHA. If cross-context code must be examined, split the job: a small pull_request_target job gathers metadata, then hands off to a separate pull_request workflow that executes the fork code."
    },
    "resources": [
      {
        "type": "code_repository",
        "name": "getplumber-examples/plumber-cli-e2e",
        "uid": "https://github.com/getplumber-examples/plumber-cli-e2e",
        "labels": [
          "findings"
        ]
      }
    ],
    "unmapped": {
