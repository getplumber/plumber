      - docker.io/google/*
      - docker.io/nvidia/*
      - docker.io/bitnami/*
      - docker.io/intel/*
      - docker.io/rocm/*
      - docker.io/redhat/*
      - docker.io/opensuse/*
      - docker.io/gentoo/*
      - docker.io/nixos/*
      - docker.io/rustlang/*
      - docker.io/amd64/*
      - docker.io/arm32v6/*
      - docker.io/arm32v7/*
      - docker.io/arm64v8/*
      - docker.io/i386/*
      - docker.io/ppc64le/*
      - docker.io/riscv64/*
      - docker.io/s390x/*
