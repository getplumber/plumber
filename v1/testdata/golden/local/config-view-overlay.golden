      - registry.gitlab.com/pipeline-components/*
      - docker.io/node:*
      - docker.io/python:*
      - docker.io/golang:*
      - docker.io/rust:*
      - docker.io/alpine:*
      - docker.io/ubuntu:*
      - docker.io/debian:*
