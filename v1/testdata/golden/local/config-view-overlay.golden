$ plumber config view -c overlay.plumber.yaml
exit: 0
--- stdout
version: "2.0"
gitlab:
  controls:
    containerImageMustNotUseForbiddenTags:
      enabled: true
      tags:
      - latest
      - dev
      - development
      - staging
      - main
      - master
      containerImagesMustBePinnedByDigest: true
    containerImageMustComeFromAuthorizedSources:
      enabled: true
      trustedUrls:
      - docker.io/library/*
      - docker.io/docker:*
      - docker.io/getplumber/plumber:*
      - docker.io/getplumber/plumber@sha256:*
      - getplumber/plumber:*
      - $CI_REGISTRY_IMAGE:*
      - $CI_REGISTRY_IMAGE/*
      - $CI_REGISTRY/*
      - ${CI_REGISTRY}/*
      - ${CI_REGISTRY_IMAGE}:*
      - ${CI_REGISTRY_IMAGE}/*
      - ${CI_DEPENDENCY_PROXY_DIRECT_GROUP_IMAGE_PREFIX}/*
      - registry.gitlab.com/security-products/*
